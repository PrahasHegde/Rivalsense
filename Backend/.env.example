# Copy this file to .env for local settings. Never commit real API keys.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Server-side Context.dev credential; never commit your real key.
CONTEXT_DEV_API_KEY=

# Same Supabase project used by the frontend. Never use a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Keep disabled until separately approved migration and PostgreSQL validation.
RIVALSENSE_RECORDING_ENABLED=false
# Blank on purpose. Provision a dedicated secret privately only after approval.
# Also required for authenticated, shared extraction quota RPCs.
RIVALSENSE_RECORDING_SECRET=
# Threshold, alerts_enabled (default false), and configurable quota limits live
# in private PostgreSQL recording_config. No environment/client alert override.
