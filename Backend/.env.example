# Copy this file to .env for local settings. Never commit real API keys.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Server-side Context.dev credential; never commit your real key.
CONTEXT_DEV_API_KEY=

# Same Supabase project used by the frontend. Never use a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PRICE_CHANGE_THRESHOLD_PERCENT=5
# Enable only after approval, application, and verification of the proposed migration.
SUPABASE_PRICE_HISTORY_RPC_ENABLED=false
